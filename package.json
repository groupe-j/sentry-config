{
  "name": "@groupe-j/sentry-config",
  "version": "0.1.5",
  "description": "Shared Sentry config + PII redaction for groupe-j apps. Extracted from ridesamui.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "require": "./dist/edge.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepublishOnly": "pnpm build && pnpm typecheck"
  },
  "peerDependencies": {
    "@sentry/nextjs": "^10.0.0",
    "@sentry/profiling-node": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@sentry/profiling-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sentry/nextjs": "^10.53.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/groupe-j/sentry-config.git"
  },
  "license": "UNLICENSED",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "sentry",
    "monitoring",
    "pii",
    "redaction",
    "groupe-j"
  ]
}
